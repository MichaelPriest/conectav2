    "test:moderation": "node --test tests/oss-moderation-safety.test.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@tensorflow/tfjs": "4.22.0",
    "@vladmandic/human": "3.3.6",
    "@zxing/browser": "0.2.1",
    "emoji-picker-react": "4.22.3",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "nsfwjs": "4.2.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.4",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
