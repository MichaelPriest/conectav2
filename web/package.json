{
  "name": "conecta-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-human.cjs && next dev",
    "build": "node scripts/prepare-human.cjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:profile": "node --test tests/profile-details.test.cjs",
    "test:human": "node --test tests/human-browser.test.cjs tests/liveness-challenge.test.cjs",
    "test:cin": "node --test tests/cin-qr.test.cjs",
    "test:govbr": "node --test tests/govbr-flow.test.cjs",
    "test:origin": "node --test tests/identity-origin.test.cjs",
    "test:legacy-rg": "node --test tests/legacy-rg-ocr.test.cjs",
