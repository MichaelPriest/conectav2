NEXT_PUBLIC_SUPABASE_URL=https://opdlxxrcdsxqmlhgayfm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO

# Optional no-cost Web Push, server-side only. Never prefix secret keys with NEXT_PUBLIC_.
# WEB_PUSH_VAPID_PUBLIC_KEY=<generated public VAPID key>
# WEB_PUSH_VAPID_PRIVATE_KEY=<generated private VAPID key>
# WEB_PUSH_VAPID_SUBJECT=https://conectav2-validacao.onrender.com
# Alternativa: mailto:your-contact@example.com
# SUPABASE_SERVICE_ROLE_KEY=<Supabase secret service role key, server-only>

# Optional signed DB webhook, never copy this secret to the browser.
# CHAT_PUSH_WEBHOOK_SECRET=<same random HMAC key configured in Supabase Vault>

# Optional WebRTC TURN relay (self-host coturn). Server-side secrets only.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=<coturn static-auth-secret; never use NEXT_PUBLIC_>
