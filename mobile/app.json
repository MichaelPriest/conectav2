{
  "expo": {
    "name": "Conecta",
    "slug": "conecta-v2",
    "scheme": "conecta",
    "version": "0.6.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.conectav2.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Conecta usa a câmera somente quando você escolhe fotografar ou gravar uma mídia.",
        "NSMicrophoneUsageDescription": "O Conecta usa o microfone somente quando você inicia uma gravação de mensagem de voz.",
        "NSPhotoLibraryUsageDescription": "O Conecta acessa apenas fotos e vídeos que você selecionar para compartilhar."
      },
      "buildNumber": "9"
    },
    "android": {
      "package": "br.com.conectav2.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8055F5"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 9
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Conecta acessa apenas fotos e vídeos que você selecionar para compartilhar.",
          "cameraPermission": "Permita a câmera para fotografar quando você escolher publicar uma imagem.",
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permita o microfone quando você decidir gravar uma mensagem de voz.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9FE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8055F5",
          "defaultChannel": "conecta-social"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9FE"
    }
  }
}
