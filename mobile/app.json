{
  "expo": {
    "name": "Conecta",
    "slug": "conecta-v2",
    "scheme": "conecta",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.conectav2.app",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera será utilizada apenas quando você escolher capturar uma foto ou participar de uma videochamada.",
        "NSMicrophoneUsageDescription": "O microfone será utilizado somente quando você iniciar mensagens de voz ou chamadas.",
        "NSPhotoLibraryUsageDescription": "Selecione fotos e vídeos para compartilhar no Conecta."
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "br.com.conectav2.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8055F5"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 5
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Conecta acessa apenas as fotos e vídeos que você selecionar para publicar.",
          "cameraPermission": "O Conecta utiliza a câmera apenas quando você escolher tirar uma foto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Conecta utiliza o microfone somente quando você gravar uma mensagem de voz.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9FE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9FE"
    }
  }
}
