{
  "expo": {
    "name": "Conecta",
    "slug": "conecta-v2",
    "scheme": "conecta",
    "version": "0.7.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.conectav2.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Conecta usa a câmera somente quando você fotografa ou participa de uma videochamada.",
        "NSMicrophoneUsageDescription": "O Conecta usa o microfone somente quando você grava áudio ou participa de chamadas de voz e vídeo.",
        "NSPhotoLibraryUsageDescription": "O Conecta acessa apenas fotos e vídeos que você selecionar para compartilhar."
      },
      "buildNumber": "12"
    },
    "android": {
      "package": "br.com.conectav2.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8055F5"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 12,
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_STATE",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O Conecta acessa apenas fotos e vídeos que você selecionar para compartilhar.",
          "cameraPermission": "Permita a câmera para fotografar quando você escolher publicar uma imagem.",
          "microphonePermission": "O microfone é utilizado apenas quando você escolhe gravar uma mensagem de voz ou iniciar uma chamada."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permita o microfone quando você decidir gravar uma mensagem de voz.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9FE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8055F5",
          "defaultChannel": "conecta-social"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9FE"
    }
  }
}
